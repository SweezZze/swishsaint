# shellcheck shell=bash disable=SC2034
# Identité du fork : c'est le SEUL fichier à modifier pour renommer l'app.
# Lu par fork/*.sh et par les workflows .github/workflows/fork-*.yml.

# Nom affiché de l'app (Finder, Dock, menus). Sans « Vorssaint » (voir TRADEMARKS.md de l'officiel).
FORK_APP_NAME="Swishsaint"

# Identifiant macOS unique de l'app. Ne doit PAS finir par « .dev » :
# l'app officielle traite tout identifiant en .dev comme un build de développement.
FORK_BUNDLE_ID="io.github.hectorpasserat2004-create.swishsaint"

# Nom du certificat de signature auto-signé du fork (créé une fois par fork/setup-signing.sh).
FORK_SIGNING_IDENTITY="Swishsaint Signing"

# Repo officiel suivi automatiquement par .github/workflows/fork-sync.yml.
UPSTREAM_REPO="vorssaint/vorssaint-utils"
UPSTREAM_BRANCH="main"
